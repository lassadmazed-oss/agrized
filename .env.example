# Copy to .env and fill in. Never commit .env.

# Supabase project
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token, used only by `npm run db:types`
SUPABASE_ACCESS_TOKEN=

# Database (session pooler, port 5432), used by `npm run db:migrate` and `npm run db:test`
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Optional: path to the Supabase CA certificate to verify TLS in the scripts
SUPABASE_DB_CA_CERT=

# Random secret used to hash visitor IPs for anti-spam throttling
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# One-time local setup link for the first Back Office password (local development only)
ADMIN_SETUP_TOKEN=
