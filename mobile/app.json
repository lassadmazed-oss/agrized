{
  "expo": {
    "name": "AgriZed",
    "slug": "agrized",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agrized",
    "userInterfaceStyle": "light",
    "primaryColor": "#1f4a2c",
    "description": "زيتونتك اليوم… أصل لعمر كامل. تصفّح عروض الزيتون، احسب مشروعك، وسجّل اهتمامك.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.agrized.app",
      "infoPlist": {
        "CFBundleDisplayName": "AgriZed",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "باش نوريّك العروض القريبة منّك ونحسبلك البعد. تنجّم ترفض وتختار الولاية بيدك."
      }
    },
    "android": {
      "package": "site.agrized.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFA"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFA"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1f4a2c",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "باش نوريّك العروض القريبة منّك ونحسبلك البعد. تنجّم ترفض وتختار الولاية بيدك.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aec2b821-ba86-4791-92cf-ddc57057a615"
      }
    },
    "owner": "saifelleuchi"
  }
}
